{
  "name": "@cap/backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/lambda/handler.js --bundle --platform=node --target=node24 --outfile=dist/bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-rds-data": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@cap/shared": "*",
    "@cap/sim-engine": "*",
    "@cap/sim-shared": "*",
    "axios": "^1.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.0",
    "jose": "^5.0.0",
    "mammoth": "^1.13.0",
    "pg": "^8.13.0",
    "serverless-http": "^3.2.0",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
