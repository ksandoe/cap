{
  "name": "@cap/backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "nodemon --watch src --ext ts -r ts-node/register src/app.ts",
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/lambda/handler.js --bundle --platform=node --target=node20 --outfile=dist/bundle.js",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb":        "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/lib-dynamodb":           "^3.0.0",
    "@cap/shared":                     "*",
    "axios":                           "^1.6.0",
    "express":                         "^4.18.0",
    "jose":                            "^5.0.0",
    "ltijs":                           "^5.9.0",
    "serverless-http":                 "^3.2.0",
    "uuid":                            "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node":    "^20.0.0",
    "@types/uuid":    "^9.0.0",
    "esbuild":        "^0.20.0",
    "nodemon":        "^3.0.0",
    "ts-node":        "^10.0.0",
    "typescript":     "^5.0.0"
  }
