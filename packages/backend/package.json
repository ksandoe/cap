{
  "name": "@cap/backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/lambda/handler.js --bundle --platform=node --target=node20 --outfile=dist/bundle.js",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb":        "^3.0.0",
    "@aws-sdk/client-rds-data":        "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/lib-dynamodb":           "^3.0.0",
    "@cap/shared":                     "*",
    "axios":                           "^1.6.0",
    "dotenv":                          "^16.6.1",
    "express":                         "^4.18.0",
    "jose":                            "^5.0.0",
    "ltijs":                           "^5.9.0",
    "pg":                              "^8.13.0",
    "serverless-http":                 "^3.2.0",
    "uuid":                            "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node":    "^20.0.0",
    "@types/pg":      "^8.11.0",
    "@types/uuid":    "^9.0.0",
    "esbuild":        "^0.20.0",
    "node-pg-migrate": "^7.9.1",
    "tsx":            "^4.23.13",
    "typescript":     "^5.0.0"
  }
}
