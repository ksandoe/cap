# ── Anthropic ──────────────────────────────────────────────────────────────
# Stored in Secrets Manager at runtime; .env for local dev only
ANTHROPIC_API_KEY=

# ── Canvas LTI 1.3 ────────────────────────────────────────────────────────
LTI_PLATFORM_URL=https://canvas.institution.edu
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_PLATFORM_JWKS_URL=https://canvas.institution.edu/api/lti/security/jwks
LTI_OIDC_AUTH_URL=https://canvas.institution.edu/api/lti/authorize_redirect
LTI_REDIRECT_URI=https://<your-domain>/lti/launch

# ── SAP ───────────────────────────────────────────────────────────────────
SAP_BASE_URL=https://sap.institution.edu
SAP_OAUTH_TOKEN_URL=https://sap.institution.edu/sap/bc/sec/oauth2/token
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_POOL_RESET_ENDPOINT=/sap/opu/odata/sap/ZUSER_RESET_SRV

# ── Credly ────────────────────────────────────────────────────────────────
CREDLY_API_BASE=https://api.credly.com/v1
CREDLY_ORG_ID=
CREDLY_REFRESH_TOKEN=

# ── AWS ───────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
DYNAMODB_TABLE_SESSIONS=cap-sessions
DYNAMODB_TABLE_SAP_POOL=cap-sap-pool
DYNAMODB_TABLE_RECIPES=cap-recipes

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
SESSION_JWT_SECRET=
SESSION_TTL_HOURS=8
