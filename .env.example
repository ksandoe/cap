# ── OpenAI ─────────────────────────────────────────────────────────────────
# Works with any OpenAI-compatible chat completions endpoint.
# For Azure OpenAI: OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#                   OPENAI_AUTH_STYLE=api-key   OPENAI_API_VERSION=2024-02-01
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_AUTH_STYLE=bearer
# OPENAI_API_VERSION=

# ── Aurora PostgreSQL ───────────────────────────────────────────────────────
# Direct pg connection — used for local dev and migrations.
# AURORA_DATABASE_URL=postgresql://user:pass@<cluster-endpoint>:5432/cap_prod
# RDS Data API (Lambda/prod — no persistent connection):
# AURORA_RESOURCE_ARN=  AURORA_SECRET_ARN=  AURORA_DATABASE=cap_prod
DATABASE_URL=

# ── Canvas LTI 1.3 ──────────────────────────────────────────────────────────
LTI_PLATFORM_URL=https://canvas.institution.edu
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_PLATFORM_JWKS_URL=https://canvas.institution.edu/api/lti/security/jwks
LTI_OIDC_AUTH_URL=https://canvas.institution.edu/api/lti/authorize_redirect
LTI_REDIRECT_URI=https://<your-domain>/lti/launch

# ── SAP ─────────────────────────────────────────────────────────────────────
SAP_BASE_URL=https://sap.institution.edu
SAP_OAUTH_TOKEN_URL=https://sap.institution.edu/sap/bc/sec/oauth2/token
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_POOL_RESET_ENDPOINT=/sap/opu/odata/sap/ZUSER_RESET_SRV

# ── Credly ──────────────────────────────────────────────────────────────────
CREDLY_API_BASE=https://api.credly.com/v1
CREDLY_ORG_ID=
CREDLY_REFRESH_TOKEN=

# ── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
DYNAMODB_TABLE_SESSIONS=cap-sessions
DYNAMODB_TABLE_SAP_POOL=cap-sap-pool
DYNAMODB_TABLE_RECIPES=cap-recipes

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
SESSION_JWT_SECRET=
SESSION_TTL_HOURS=8
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Local dev switches ──────────────────────────────────────────────────────
# USE_LOCAL_DB=true → JSON-file store (packages/backend/.dev-data/) instead of
# DynamoDB. Seeds a demo recipe, SAP pool accounts, and dev admin logins
# (admin@cap.local / dev-admin-password; also author@, instructor@, researcher@).
# Each integration flips stub→live independently as campus credentials arrive:
#   LLM_MODE=mock|openai   (auto: openai when OPENAI_API_KEY set, else mock)
#   SAP_MODE / CANVAS_MODE / CREDLY_MODE = stub|live  (default: stub under USE_LOCAL_DB)
USE_LOCAL_DB=true
LLM_MODE=mock
SAP_MODE=stub
CANVAS_MODE=stub
CREDLY_MODE=stub
