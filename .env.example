# ── OpenAI ─────────────────────────────────────────────────────────────────
# Works with any OpenAI-compatible chat completions endpoint.
# For Azure OpenAI: OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#                   OPENAI_AUTH_STYLE=api-key   OPENAI_API_VERSION=2024-02-01
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_AUTH_STYLE=bearer
# OPENAI_API_VERSION=

# ── Aurora PostgreSQL ───────────────────────────────────────────────────────
# Direct pg connection — used for local dev and migrations.
# AURORA_DATABASE_URL=postgresql://user:pass@<cluster-endpoint>:5432/cap_prod
# RDS Data API (Lambda/prod — no persistent connection):
# AURORA_RESOURCE_ARN=  AURORA_SECRET_ARN=  AURORA_DATABASE=cap_prod
DATABASE_URL=

# ── Canvas LTI 1.3 ──────────────────────────────────────────────────────────
LTI_PLATFORM_URL=https://canvas.institution.edu
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_PLATFORM_JWKS_URL=https://canvas.institution.edu/api/lti/security/jwks
LTI_OIDC_AUTH_URL=https://canvas.institution.edu/api/lti/authorize_redirect
LTI_REDIRECT_URI=https://<your-domain>/lti/launch
# Activity opened when a launch carries no activity_id custom parameter, so one Canvas
# key can open one activity without a custom field set in Canvas. A custom parameter,
# when Canvas sends one, always wins.
LTI_DEFAULT_ACTIVITY_ID=sim-sales-process
# Where a verified launch lands. Default (unset): the landing page, which shows the
# activity inside a Canvas frame with a button that opens it in a new tab, and passes
# straight on to the activity when it is not in a frame. "off" sends every launch to
# the activity directly (the behavior before the landing page existed).
# LTI_LANDING_PAGE=off

# ── SAP ─────────────────────────────────────────────────────────────────────
SAP_BASE_URL=https://sap.institution.edu
SAP_OAUTH_TOKEN_URL=https://sap.institution.edu/sap/bc/sec/oauth2/token
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_POOL_RESET_ENDPOINT=/sap/opu/odata/sap/ZUSER_RESET_SRV

# ── Credly ──────────────────────────────────────────────────────────────────
CREDLY_API_BASE=https://api.credly.com/v1
CREDLY_ORG_ID=
CREDLY_REFRESH_TOKEN=

# ── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
DYNAMODB_TABLE_SESSIONS=cap-sessions
DYNAMODB_TABLE_SAP_POOL=cap-sap-pool
DYNAMODB_TABLE_RECIPES=cap-recipes
DYNAMODB_TABLE_PARAMS=cap-params
DYNAMODB_TABLE_MODULE_CONFIG=cap-module-config
DYNAMODB_TABLE_EVALUATIONS=cap-evaluations
DYNAMODB_TABLE_ASSETS=cap-assets
DYNAMODB_TABLE_RECIPE_DRAFTS=cap-recipe-drafts

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# APP_SECRETS_ID: on a deployed function only. The name of an AWS Secrets Manager secret
# that supplies the sensitive values below instead of plain environment variables
# (infra/secrets.md). Leave it unset locally: nothing is loaded and this file works as is.
# APP_SECRETS_ID=cap/prod/app
# SESSION_JWT_SECRET, LEARNER_KEY_SECRET and ADMIN_PASSKEY may be left empty ONLY for local
# development (USE_LOCAL_DB=true), where a public development default is used. A deployed
# function (USE_LOCAL_DB not true) refuses to start without its own SESSION_JWT_SECRET and
# LEARNER_KEY_SECRET, and refuses admin sign-in without a passkey. Use long random values.
SESSION_JWT_SECRET=
# HMAC key for the opaque learner key derived from LTI iss+sub.
# Long-lived: rotating it breaks resume lookups and research linkage.
LEARNER_KEY_SECRET=
SESSION_TTL_HOURS=8
PORT=3001
FRONTEND_URL=http://localhost:3000
# Shared team passkey for the Admin App (v3 interim auth — OTP + per-user
# roles is the long-term design). Local development only default: cap-team-2026
# (never accepted on a deployed function).
ADMIN_PASSKEY=

# ── Local dev switches ──────────────────────────────────────────────────────
# USE_LOCAL_DB=true → JSON-file store (packages/backend/.dev-data/) instead of
# DynamoDB. Seeds a demo recipe, SAP pool accounts, and dev admin logins
# (admin@cap.local / dev-admin-password; also author@, instructor@, researcher@).
# Each integration flips stub→live independently as campus credentials arrive:
#   LLM_MODE=mock|openai   (auto: openai when OPENAI_API_KEY set, else mock)
#   SAP_MODE / CANVAS_MODE / CREDLY_MODE = stub|live  (default: stub under USE_LOCAL_DB)
USE_LOCAL_DB=true
LLM_MODE=mock
SAP_MODE=stub
CANVAS_MODE=stub
CREDLY_MODE=stub
